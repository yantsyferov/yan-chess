# Dependencies — never send into build context
**/node_modules

# Build outputs — regenerated inside Docker
**/dist

# Environment files — never bake secrets into images
**/.env
**/.env.local
**/.env.test
**/.env.*.local

# Git metadata
.git
.gitignore

# Logs
**/*.log

# Dev / local tooling output
apps/api/dev-outbox/
.playwright-mcp/
docs/screenshots/

# Project context docs (not needed at runtime)
context/
.awos/

# Test coverage
**/coverage

# Editor config
.vscode/
.idea/

# OS
.DS_Store
**/Thumbs.db

# Docker-related (avoid recursive builds)
**/Dockerfile
**/.dockerignore
