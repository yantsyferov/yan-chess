# Database — Postgres connection string
# Dev: local docker-compose. Prod: Neon pooled connection.
DATABASE_URL="postgresql://yanchess:yanchess@localhost:5432/yanchess?schema=public"

# Redis — session + socket state + rate limiter
# Dev: local docker-compose. Prod: Upstash rediss:// with TLS.
REDIS_URL="redis://localhost:6379"

# JWT access token signing secret (>= 48 random bytes recommended)
# Prod MUST override — never ship the dev default.
JWT_ACCESS_SECRET="dev-only-change-me-in-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_TTL_SEC=900

# Refresh token TTLs (seconds)
REFRESH_TTL_SEC_REMEMBER=2592000   # 30 days when "remember me" checked
REFRESH_TTL_SEC_SESSION=86400      # 1 day for regular login

# Web app origin — used for CORS allow-list and email verification links
WEB_URL="http://localhost:5173"

# Mail delivery
# "outbox" — writes JSON files to dev-outbox/ (dev default)
# "resend" — real send via Resend SaaS (prod)
MAIL_DRIVER="outbox"
# Required when MAIL_DRIVER=resend
RESEND_API_KEY=""
# Sender address, visible to recipient
MAIL_FROM="YanChess <onboarding@resend.dev>"

# Refresh cookie flags
# COOKIE_SECURE=true in prod (HTTPS-only)
COOKIE_SECURE=false
# COOKIE_SAMESITE: "lax" for same-site dev, "none" for cross-subdomain prod
# Note: "none" requires COOKIE_SECURE=true (browser enforcement)
COOKIE_SAMESITE=lax

# Runtime mode — "development" (default) or "production"
NODE_ENV=development

# HTTP port the API binds to (default 3000 if unset)
PORT=3000
