{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -k -n shared,api -c cyan,yellow 'pnpm --filter @yanchess/shared dev' 'nest start --watch'",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"no lint configured yet\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:create:test": "docker exec yanchess-postgres-1 psql -U yanchess -d postgres -tAc \"SELECT 1 FROM pg_database WHERE datname='yanchess_test'\" | grep -q 1 || docker exec yanchess-postgres-1 psql -U yanchess -d postgres -c 'CREATE DATABASE yanchess_test'",
    "db:migrate:test": "DATABASE_URL=postgresql://yanchess:yanchess@localhost:5432/yanchess_test?schema=public prisma migrate deploy",
    "db:setup:test": "pnpm db:create:test && pnpm db:migrate:test",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "test:e2e": "vitest run test/e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/schedule": "^3.0.4",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@yanchess/shared": "workspace:*",
    "argon2": "^0.41",
    "chess.js": "^1",
    "cookie-parser": "^1.4",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.22",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@types/cookie-parser": "^1.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20.16.0",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4",
    "source-map-support": "^0.5.21",
    "supertest": "^7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2"
  }
}
