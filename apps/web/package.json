    "@yanchess/shared": "workspace:*",
    "chess.js": "^1",
    "i18next": "^23.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-chessboard": "^4",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4",
    "sonner": "^2.0.8",
    "stockfish": "^19.0.1",
    "zod": "^3.23.0",
    "zustand": "^4.5"
